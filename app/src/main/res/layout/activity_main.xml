<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="手把映射設定步驟"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="1. 開啟無障礙服務" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="2. 開啟懸浮窗權限" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="完成以上兩個權限後，畫面左側會出現三顆常駐懸浮小按鈕：\n\n🎮搖桿：開關搖桿類比收訊（開啟時遊戲視窗會失去 focus，用完記得關）\n⚙設定：開關按鍵位置設定模式，畫面會出現可拖曳的紅色（按鍵）/藍色（左搖桿中心）/青色（右搖桿中心）標記，拖到遊戲對應按鈕位置後按「儲存位置」。輕點（不是拖曳）任一顆按鍵標記可開啟編輯面板，把該按鍵切換成「巨集」（依序點擊多個位置，每步可設定等待時間）\n🔍測試：開關按鍵測試模式，按手把按鍵或推搖桿時，畫面下方會即時顯示對應的 keyCode 與軸值\n\n這三顆按鈕不管你在哪個 App（包含遊戲畫面）都會顯示在最上層，直接切到 DQ10 後點它們操作即可，不需要切回這個 App。按住可以拖曳到不擋視線的位置。"
        android:textSize="14sp" />

</LinearLayout>
